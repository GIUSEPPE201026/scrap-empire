extends "res://tests/crafting_test.gd"
const Focus = preload("res://scripts/gameplay/interaction_focus.gd")

func press_e(player) -> void:
	var event = InputEventAction.new()
	event.action="interact"
	event.pressed=true
	player._unhandled_input(event)

func run() -> void:
	get_tree().current_scene=null
	SaveService.SAVE_DIR="res://test_logs/focus_%d/" % Time.get_ticks_usec()
	SaveService._ensure_save_dir()
	SessionState.progression_loaded=true
	get_tree().change_scene_to_file("res://scenes/boot.tscn")
	await frames(8)
	get_tree().current_scene._on_single_pressed()
	await frames(25)
	var player = get_tree().get_first_node_in_group("players")
	var sector = get_tree().get_first_node_in_group("sector")
	await look(player,Vector3(0,0.05,11.5),Vector3(0,1.1,14))
	check(Focus.resolve(player).kind=="depot" and player._interact_prompt.text.contains("BILANCIA"),"scale prompt and spatial focus agree")
	press_e(player)
	check(player._is_paused and player._pause_menu!=null,"E opens exactly the indicated scale")
	await capture("focus_scale")
	player._close_pause_menu()
	await look(player,Vector3(0,0.05,11.5),Vector3(0,1.6,8))
	check(Focus.resolve(player).kind=="none" and not player._interact_prompt.text.contains("BILANCIA"),"being nearby while looking away cannot select scale")
	press_e(player)
	check(not player._is_paused,"E facing away leaves gameplay active")
	var barrier = StaticBody3D.new()
	var shape = CollisionShape3D.new()
	shape.shape=BoxShape3D.new()
	shape.shape.size=Vector3(3,3,0.2)
	barrier.add_child(shape)
	sector.add_child(barrier)
	barrier.position=Vector3(0,1.5,12.7)
	await look(player,Vector3(0,0.05,11.5),Vector3(0,1.1,14))
	check(Focus.resolve(player).kind=="none","obstruction hides scale interaction")
	press_e(player)
	check(not player._is_paused,"E cannot open scale through obstruction")
	barrier.queue_free()
	await frames(3)
	var parts: Array = get_tree().get_nodes_in_group("bulk_parts")
	parts[0].position=Vector3(35,0,14)
	parts[1].position=Vector3(33.9,0,15)
	await look(player,Vector3(35,0.05,16),parts[0].position+Vector3.UP*0.35)
	check(Focus.resolve(player).get("node")==parts[0],"aim selects intended component over closer off-axis component")
	check(player._interact_prompt.text.contains(parts[0].display_name()),"component popup names selected object")
	var wanted: String = parts[0].part_id
	press_e(player)
	await frames(3)
	check(GameState.operations.held.get("id","")==wanted and Focus.resolve(player).kind=="carry","E lifts indicated component and switches to carrying context")
	GameState.ops.store_held()
	GameState.yard_level=1
	GameState.vehicle_level=2
	sector.spawn_owned_vehicles()
	var buggy = get_tree().get_nodes_in_group("yard_vehicles").filter(func(node):return node.level==2)[0]
	buggy.position=Vector3(40,0,10)
	await look(player,buggy.position+Vector3(0,0.05,3),buggy.to_global(Vector3(0,1.2,1.6)))
	check(Focus.resolve(player).kind=="cargo" and player._interact_prompt.text.contains("CASSONE"),"rear of buggy consistently indicates cargo")
	press_e(player)
	check(player._is_paused and player._mounted_vehicle==null,"rear E opens cargo without entering seat")
	player._close_pause_menu()
	await look(player,buggy.position+Vector3(1.7,0.05,0.15),buggy.to_global(Vector3(0,1.2,0.15)))
	check(Focus.resolve(player).kind=="vehicle" and player._interact_prompt.text.contains("GUIDA"),"driver side consistently indicates seat")
	press_e(player)
	await frames(3)
	check(player._mounted_vehicle==buggy and Focus.resolve(player).kind=="dismount","side E enters actual driver seat")
	await capture("focus_driver")
	press_e(player)
	await frames(3)
	check(player._mounted_vehicle==null,"mounted E retains safe dismount behavior")
	await frames(24)
	var station = get_tree().get_nodes_in_group("operations_service").filter(func(node):return node.get_meta("operation")=="craft")[0]
	await look(player,station.position+Vector3(0,0.05,-2),station.position+Vector3.UP*1.2)
	check(Focus.resolve(player).kind=="operation" and Focus.resolve(player).service=="craft","workbench is selected by looking at actual bench")
	press_e(player)
	check(player._is_paused,"workbench E opens construction menu")
	await capture("focus_workbench")
	print("INTERACTION_FOCUS_RESULT: %d checks, %d failures" % [checks,failures])
	get_tree().quit(1 if failures else 0)
